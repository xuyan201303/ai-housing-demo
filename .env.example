OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Existing default. Select azure_tts only after an explicitly authorized audition.
VOICE_OUTPUT_PROVIDER=openai_realtime
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
AZURE_SPEECH_STYLE=chat
# User-selected candidate; enable only in acceptance environment first.
AZURE_SPEECH_RATE=+15%
AZURE_SPEECH_STYLEDEGREE=1.15
DATABASE_URL=sqlite:///./data/housing.db
UPLOAD_DIR=./uploads
DEMO_MODE=demo
ADMIN_PASSWORD=
STAFF_PASSWORD=
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
